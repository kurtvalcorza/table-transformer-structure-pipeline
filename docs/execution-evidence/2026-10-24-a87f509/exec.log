 def stage_detection_metrics(args):                                             
     global det_rows,det_metrics                                                
     det_pred_lists=[]                                                          
     det_refs=[]                                                                
     det_rows=[]                                                                
     for item in canonical_tables:                                              
         preds=[{"label":"table","score":x["score"],"box":x["box"]} for x in    
 item["detections"]]                                                            
         det_pred_lists.append(preds)                                           
         det_refs.append([{"label":"table","box":item["page_gt_box"]}])         
         best=max([box_iou(x["box"],item["page_gt_box"]) for x in               
 item["detections"]],default=0.0)                                               
         # Codex #7: the pipeline crops the highest-scoring detection, which    
 need not be the best-overlapping one.                                          
         chosen=item.get("selected_detection")                                  
         selected=box_iou(chosen["box"],item["page_gt_box"]) if chosen else 0.0 
         det_rows.append({                                                      
             "table_id":item["source_id"],"predicted":bool(item["detections"]), 
             "best_iou":best,"hit50":best>=0.5,"hit75":best>=0.75,              
             "selected_iou":selected,"selected_hit50":selected>=0.5,            
         })                                                                     
                                                                                
     det_metrics={                                                              
         "ap50":ap_for_label(det_pred_lists,det_refs,"table",0.5),              
         "ap75":ap_for_label(det_pred_lists,det_refs,"table",0.75),             
         "hit50":float(np.mean([r["hit50"] for r in det_rows])),                
         "hit75":float(np.mean([r["hit75"] for r in det_rows])),                
         "mean_best_iou":float(np.mean([r["best_iou"] for r in det_rows])),     
         "median_best_iou":float(np.median([r["best_iou"] for r in det_rows])), 
     }                                                                          
     # TBL2-m3: mean_best_iou scores a page with no detection as IoU 0; this    
 mean covers the detected pages only.                                           
     detected_ious=[r["best_iou"] for r in det_rows if r["predicted"]]          
     det_metrics["detected_pages"]=len(detected_ious)                           
     det_metrics["mean_best_iou_detected"]=float(np.mean(detected_ious)) if     
 detected_ious else None                                                        
     det_metrics["selected_hit50"]=float(np.mean([r["selected_hit50"] for r in  
 det_rows]))                                                                    
     det_metrics["mean_selected_iou"]=float(np.mean([r["selected_iou"] for r in 
 det_rows]))                                                                    
     det_metrics["ap_scope"]="threshold-filtered: only detections above the     
 detection threshold are ranked"                                                
     print(det_metrics)                                                         
                                                                                
