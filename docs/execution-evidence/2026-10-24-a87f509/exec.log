                for name,rows in                                                
 (("gold_table",gold_qa),("structure_only",structure_qa),("end_to_end",end_to_e 
 nd_qa))                                                                        
                for rule in ("value","strict") for kind in                      
 ("correct","accuracy")},                                                       
         },                                                                     
     }                                                                          
     # TBL2-M1 / codex #1-#2: compare paths question by question. The           
 gold-table path is a reference diagnostic, not a                               
     # ceiling: a changed table can turn a wrong gold answer right as well as a 
 right one wrong, and losses and gains                                          
     # can cancel. score_path walks qa_records in order for every path, so      
 position i is the same question on all three.                                  
     paths=list(zip(gold_qa,structure_qa,end_to_end_qa))                        
                                                                                
     def compare(pairs,key):                                                    
         lost=[b for a,b in pairs if a[key] and not b[key]]                     
         gained=[b for a,b in pairs if b[key] and not a[key]]                   
         return {                                                               
             "lost":len(lost),"gained":len(gained),"net_correct_change":len(gai 
 ned)-len(lost),                                                                
             "lost_by_status":dict(Counter("answered_differently" if            
 b["pipeline_status"]=="ok" else b["pipeline_status"] for b in lost)),          
         }                                                                      
                                                                                
     def attribution(rule):                                                     
         key=rule+"_correct"                                                    
         return {                                                               
             "wrong_on_gold_table":sum(1 for g,_s,_e in paths if not g[key]),   
             "gold_table_to_structure_only":compare([(g,s) for g,s,_e in        
 paths],key),                                                                   
             "structure_only_to_end_to_end":compare([(s,e) for _g,s,e in        
 paths],key),                                                                   
             "gold_table_to_end_to_end":compare([(g,e) for g,_s,e in            
 paths],key),                                                                   
             "net_correct_change_vs_gold":{                                     
                 "structure_only":waterfall["qa"][f"structure_only_{key}"]-wate 
 rfall["qa"][f"gold_table_{key}"],                                              
                 "end_to_end":waterfall["qa"][f"end_to_end_{key}"]-waterfall["q 
 a"][f"gold_table_{key}"],                                                      
             },                                                                 
         }                                                                      
                                                                                
     waterfall["loss_attribution"]={                                            
         "unit":"questions out of qa.questions, compared question by question   
 under each co-primary rule; lost and gained are gross counts and               
 net_correct_change = gained - lost",                                           
         "value":attribution("value"),                                          
         "strict":attribution("strict"),                                        
     }                                                                          
     print(json.dumps(waterfall,indent=2))                                      
                                                                                
     # Display only: each question not right on all three paths under either    
 rule, with both rules' transitions.                                            
     def transitions(g,s,e,key):                                                
         out=[]                                                                 
         if not g[key]:out.append("wrong on the gold table")                    
         if g[key] and not s[key]:                                              
             out.append("lost gold -> structure-only ("+("answered differently" 
 if s["pipeline_status"]=="ok" else s["pipeline_status"])+")")                  
         if s[key] and not g[key]:out.append("recovered on structure-only")     
         if s[key] and not e[key]:                                              
             if e["pipeline_status"]=="detection_miss":out.append("lost         
 structure-only -> end-to-end (detection miss)")                                
             elif e["pipeline_status"]!="ok":out.append("lost structure-only -> 
 end-to-end ("+e["pipeline_status"]+" on the detected crop)")                   
             else:out.append("lost structure-only -> end-to-end (answered       
 differently; associated with the crop-path change)")                           
         if e[key] and not s[key]:out.append("recovered end to end")            
         return "; ".join(out) or "right on every path"                         
                                                                                
     rules=("value_correct","strict_correct")                                   
     trace=[(i,g,s,e) for i,(g,s,e) in enumerate(paths) if not all(r[k] for r   
