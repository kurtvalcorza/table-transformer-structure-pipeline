 def accepted_answer_matches(result,accepted):                                  
     """Numbers compare within 1e-6 when both sides parse as numbers; anything  
 else compares as normalized text."""                                           
     predicted=result["numeric_answer"] if result["aggregation"]!="NONE" else   
 ", ".join(result["cells"])                                                     
     if predicted is None:                                                      
         return False                                                           
     p,a=parse_number(predicted),parse_number(accepted)                         
     if p is not None and a is not None:                                        
         return abs(p-a)<=1e-6                                                  
     return norm_cell(predicted)==norm_cell(accepted)                           
                                                                                
 def read_byod_csv(path,required):                                              
     """Rows with their file line numbers (line 1 is the header); names any     
 missing column."""                                                             
     with open(path,encoding="utf-8-sig",newline="") as f:                      
         reader=csv.DictReader(f)                                               
         lacking=sorted(required-set(reader.fieldnames or []))                  
         if lacking:                                                            
             raise ByodRefusal(f"{path.name}: missing column(s) {lacking};      
 required columns are {sorted(required)}")                                      
         return list(enumerate(reader,start=2))                                 
                                                                                
 def stage_byod(args):                                                          
     global det_processor,det_model,struct_processor,struct_model,byod_result   
     load_transformers()                                                        
     load_pandas()                                                              
     byod_result=None                                                           
     if USE_BYOD:                                                               
         # TBL2-m1 (DAT20): earlier BYOD outputs are removed before validation, 
 so a refusal leaves none behind.                                               
         byod_dir=Path(OUTPUT_DIR)/"byod"                                       
         if byod_dir.exists():                                                  
             shutil.rmtree(byod_dir)                                            
         if not str(BYOD_PATH).strip():                                         
             raise ByodRefusal("USE_BYOD is True but BYOD_PATH is empty: set    
 BYOD_PATH in §3 to the folder that holds pages/ and ocr.csv")                  
         root=Path(BYOD_PATH)                                                   
         pages_dir=root/"pages"                                                 
         ocr_path=root/"ocr.csv"                                                
         questions_path=root/"questions.csv"                                    
         absent=[name for name,ok in                                            
 (("pages/",pages_dir.is_dir()),("ocr.csv",ocr_path.is_file())) if not ok]      
         if absent:                                                             
             raise ByodLayoutRefusal(f"BYOD_PATH {str(root)!r} is missing       
 {absent}; use the layout shown in §28")                                        
                                                                                
         # Validate every row before any model runs; every refused row is       
 collected and reported once (TBL2-m1).                                         
         problems=[]                                                            
         ocr_by_page=defaultdict(list)                                          
         ocr_rows=read_byod_csv(ocr_path,{"page_id","text","x0","y0","x1","y1", 
 "order"})                                                                      
         for line,row in ocr_rows:                                              
             page_id=str(row["page_id"] or "").strip()                          
             if not page_id:                                                    
                 problems.append(f"ocr.csv line {line}: page_id is empty")      
                 continue                                                       
             try:                                                               
                 box=[float(row[k]) for k in ("x0","y0","x1","y1")]             
             except (TypeError,ValueError):                                     
                 problems.append(                                               
                     f"ocr.csv line {line}: x0,y0,x1,y1 must be numbers in      
 page-image pixels, got "                                                       
                     f"{[row[k] for k in ('x0','y0','x1','y1')]}"               
                 )                                                              
                 continue                                                       
             if not all(math.isfinite(v) for v in box) or box[0]>box[2] or      
 box[1]>box[3]:                                                                 
                 problems.append(f"ocr.csv line {line}: box {box} needs finite  
 values with x0<=x1 and y0<=y1 (top-left origin)")                              
                 continue                                                       
             try:                                                               
                 order=int(str(row["order"]).strip())                           
             except ValueError:                                                 
                 problems.append(f"ocr.csv line {line}: order must be a whole   
 number, got {row['order']!r}")                                                 
                 continue                                                       
             ocr_by_page[page_id].append({"text":str(row["text"] or             
 ""),"box":box,"order":order,"line":line})                                      
         if not ocr_rows:                                                       
             problems.append("ocr.csv has a header but no rows")                
         for page_id in ocr_by_page:                                            
             ocr_by_page[page_id].sort(key=lambda x:x["order"])                 
                                                                                
         q_by_page=defaultdict(list)                                            
         if questions_path.is_file():                                           
             for line,row in                                                    
 read_byod_csv(questions_path,{"id","page_id","question"}):                     
                 if not str(row["question"] or "").strip() or not               
 str(row["page_id"] or "").strip():                                             
                     problems.append(f"questions.csv line {line}: page_id and   
 question must be non-empty")                                                   
                     continue                                                   
                 q_by_page[str(row["page_id"]).strip()].append(row)             
         if problems:                                                           
             byod_refuse(problems)                                              
                                                                                
         byod_skipped=[]                                                        
         byod_inputs=[]                                                         
         for image_path in sorted(pages_dir.iterdir()):                         
             if not image_path.is_file():                                       
                 continue                                                       
             if image_path.suffix.lower() not in BYOD_IMAGE_SUFFIXES:           
                 byod_skipped.append({"file":image_path.name,"reason":"unsuppor 
 ted_extension"})                                                               
             elif image_path.stem not in ocr_by_page:                           
                 byod_skipped.append({"file":image_path.name,"reason":"no_ocr_r 
 ows"})                                                                         
             else:                                                              
                 byod_inputs.append(image_path)                                 
         ocr_without_image=sorted(set(ocr_by_page)-{p.stem for p in             
 byod_inputs})                                                                  
         if not byod_inputs:                                                    
             raise ByodRefusal(                                                 
                 f"No page in {pages_dir} has OCR rows. Skipped:                
 {byod_skipped}. "                                                              
                 f"ocr.csv page_ids: {sorted(ocr_by_page)[:10]}. A page_id must 
 equal its image file name without the extension."                              
             )                                                                  
                                                                                
         byod_images={}                                                         
         for image_path in byod_inputs:                                         
             image=Image.open(image_path); image.load();                        
 image=image.convert("RGB")                                                     
             if min(image.size)<16 or max(image.size)>4096:                     
                 problems.append(f"{image_path.name}: page is                   
 {image.width}x{image.height}; each side must be 16..4096 px")                  
                 continue                                                       
             outside=[w["line"] for w in ocr_by_page[image_path.stem]           
                      if w["box"][0]<-1 or w["box"][1]<-1 or                    
 w["box"][2]>image.width+1 or w["box"][3]>image.height+1]                       
             if outside:                                                        
                 problems.append(                                               
                     f"ocr.csv lines {outside}: boxes for {image_path.stem}     
 extend beyond its {image.width}x{image.height} image. "                        
                     "Boxes must be page-image pixels with a top-left origin;   
 convert PDF points or a bottom-left origin first"                              
                 )                                                              
                 continue                                                       
             byod_images[image_path.stem]=image                                 
         if problems:                                                           
             byod_refuse(problems)                                              
                                                                                
