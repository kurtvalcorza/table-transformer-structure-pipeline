 def source_cells_in_crop(item,crop_box):                                       
     cx0,cy0,_,_=crop_box                                                       
     page_left,page_top=120,160                                                 
     out=[]                                                                     
     for c in item["cells"]:                                                    
         b=c["box"]                                                             
         out.append({                                                           
             **c,                                                               
             "crop_box":[b[0]+page_left-cx0,b[1]+page_top-cy0,b[2]+page_left-cx 
 0,b[3]+page_top-cy0],                                                          
         })                                                                     
