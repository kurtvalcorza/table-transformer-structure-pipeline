 def norm_cell(s):                                                              
     return " ".join(str(s).lower().split())                                    
                                                                                
 def final_denotation(result):                                                  
     """The pipeline's one final answer: the selected cell strings when TAPAS   
 predicts NONE, otherwise the number its                                        
     predicted operator computes from them (None when they do not parse)."""    
     return result["cells"] if result["aggregation"]=="NONE" else               
 result["numeric_answer"]                                                       
                                                                                
 def value_correct(result,record):                                              
     """Value-equality rule, one of two co-primary rules: score the final       
 denotation built from the predicted cells and                                  
     the predicted operator. A lookup answered with SUM/AVERAGE/COUNT counts    
 when that number equals the gold cell's value."""                              
     gold=record["gold_denotation"]                                             
     predicted=final_denotation(result)                                         
     if predicted is None:                                                      
         return False                                                           
     if isinstance(gold,list):                                                  
         if isinstance(predicted,list):                                         
             return sorted(norm_cell(x) for x in                                
 predicted)==sorted(norm_cell(x) for x in gold)                                 
         value=parse_number(gold[0]) if len(gold)==1 else None                  
         return value is not None and abs(float(predicted)-value)<=1e-6         
     if isinstance(predicted,list):                                             
         return False                                                           
     return abs(float(predicted)-float(gold))<=1e-6                             
                                                                                
 def strict_correct(result,record):                                             
     """Strict-operator rule, the other co-primary rule: a lookup counts only   
 when TAPAS predicted NONE and selected the                                     
     gold cell; an aggregation question needs the predicted operator to equal   
 the gold one and the value to match."""                                        
     gold=record["gold_denotation"]                                             
     if isinstance(gold,list):                                                  
         return result["aggregation"]=="NONE" and sorted(norm_cell(x) for x in  
 result["cells"])==sorted(norm_cell(x) for x in gold)                           
     value=result["numeric_answer"]                                             
     return result["aggregation"]==record["gold_aggregation"] and value is not  
 None and abs(float(value)-float(gold))<=1e-6                                   
                                                                                
 def score_path(path_name,table_provider):                                      
     rows=[]                                                                    
     times=[]                                                                   
     for record in qa_records:                                                  
         item=next(x for x in canonical_tables if                               
 x["source_id"]==record["table_id"])                                            
         table,status=table_provider(item)                                      
         if table is None:                                                      
             rows.append({                                                      
                 "question_id":record["id"],"table_id":record["table_id"],"path 
 ":path_name,                                                                   
                 "question":record["question"],"gold_aggregation":record["gold_ 
 aggregation"],                                                                 
                 "predicted_aggregation":None,"gold_denotation":record["gold_de 
 notation"],                                                                    
                 "predicted_denotation":None,"value_correct":False,"strict_corr 
 ect":False,                                                                    
                 "aggregation_correct":False,"selected_cells_match":None,"coord 
 inates_exact":False,                                                           
                 "selected_cells":[],"coordinates":[],                          
                 "pipeline_status":status,"latency_seconds":None,               
             })                                                                 
             continue                                                           
         t=time.perf_counter()                                                  
         result=tapas_answer(table,record["question"])                          
         times.append(time.perf_counter()-t)                                    
         rows.append({                                                          
             "question_id":record["id"],"table_id":record["table_id"],"path":pa 
 th_name,                                                                       
             "question":record["question"],"gold_aggregation":record["gold_aggr 
 egation"],                                                                     
             "predicted_aggregation":result["aggregation"],"gold_denotation":re 
 cord["gold_denotation"],                                                       
             "predicted_denotation":final_denotation(result),                   
             "value_correct":value_correct(result,record),"strict_correct":stri 
 ct_correct(result,record),                                                     
             "selected_cells_match":selected_cells_match(result,record),        
             "coordinates_exact":coordinates_exact(result,record),              
             "aggregation_correct":result["aggregation"]==record["gold_aggregat 
 ion"],                                                                         
             "selected_cells":result["cells"],"coordinates":result["coordinates 
 "],                                                                            
             "pipeline_status":"ok","latency_seconds":times[-1],                
         })                                                                     
     return rows,times                                                          
                                                                                
 def gold_provider(item):                                                       
     return item["grid"],"ok"                                                   
                                                                                
 def struct_provider(item):                                                     
     r=item["gold_recon"]                                                       
     return (r["table"],"ok") if r["valid"] else (None,r["reason"])             
                                                                                
 def full_provider(item):                                                       
     if item["selected_detection"] is None:return None,"detection_miss"         
     r=item["det_recon"]                                                        
     return (r["table"],"ok") if r["valid"] else (None,r["reason"])             
                                                                                
 def qa_summary(rows):                                                          
     return {                                                                   
         "n":len(rows),                                                         
         "value_correct":int(sum(r["value_correct"] for r in rows)),            
         "value_accuracy":float(np.mean([r["value_correct"] for r in rows])),   
         "strict_correct":int(sum(r["strict_correct"] for r in rows)),          
         "strict_accuracy":float(np.mean([r["strict_correct"] for r in rows])), 
         "aggregation_accuracy":float(np.mean([r["aggregation_correct"] for r   
 in rows])),                                                                    
         "valid_questions":sum(r["pipeline_status"]=="ok" for r in rows),       
         "lookups_with_matching_cells":sum(1 for r in rows if                   
 r.get("selected_cells_match")),                                                
         "coordinate_accuracy":float(np.mean([bool(r.get("coordinates_exact"))  
 for r in rows])),                                                              
     }                                                                          
                                                                                
